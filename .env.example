# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit a filled-in copy.
# .env.local is gitignored (twice: `.env.*` and `*.local`).
# ---------------------------------------------------------------------------

# --- Supabase: the database AND auth ---------------------------------------
# Supabase dashboard -> Project Settings -> API.
#
# TWO THINGS PEOPLE GET WRONG HERE:
#
# 1. Copy the PROJECT URL, not the REST endpoint. You want
#    https://xxxx.supabase.co  --  if what you copied ends in /rest/v1/, trim
#    it. The client appends /rest/v1/... itself, so the longer form yields
#    "PGRST125: Invalid path specified in request URL" on every query, an
#    error that points nowhere near its cause. (The app trims it defensively,
#    but the URL is clearer without it.)
#
# 2. Use the PUBLISHABLE key, never the SECRET key. The publishable key
#    respects Row Level Security and is safe in a browser -- it ships in the
#    JS bundle by design. The secret key BYPASSES RLS entirely, so behind a
#    NEXT_PUBLIC_ prefix it would be inlined into the bundle and hand every
#    case in the firm to anyone who views source.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Leave both blank and the app falls back to browser localStorage, so local
# development works before a Supabase project exists.

# --- Firm settings ---------------------------------------------------------
# Every "today" and "overdue" computation resolves in this zone, never the
# browser's -- otherwise a browser running in UTC flips deadlines a day early
# after 6pm Central. Currently read from lib/domain/dates.js rather than here;
# listed so the assumption is visible.
FIRM_TIMEZONE="America/Chicago"

# ── Email on the file ────────────────────────────────────────────────────
# Dragging a .eml onto a matter works with none of these set. They are only
# needed for the per-matter intake addresses, which is the automatic path.

# Where the intake addresses live. TWO SHAPES, see docs/EMAIL_SETUP.md.
#
#   PLUS-ADDRESSING (what this firm uses) -- no DNS change at all. Everything
#   lands in one real Workspace mailbox and an Apps Script polls it.
#       NEXT_PUBLIC_INTAKE_MAIL_DOMAIN="higdonlawyers.com"
#       NEXT_PUBLIC_INTAKE_MAIL_USER="files"
#       -> files+RiveraMarcus7f3a9c2e@higdonlawyers.com
#   Any existing Workspace mailbox works; files@ already exists for Drive, so
#   reusing it needs no new licence. See docs/EMAIL_SETUP.md.
#
#   SUBDOMAIN -- nicer address, needs an MX record.
#       NEXT_PUBLIC_INTAKE_MAIL_DOMAIN="case.higdonlawyers.com"
#       NEXT_PUBLIC_INTAKE_MAIL_USER=""
#       -> RiveraMarcus7f3a9c2e@case.higdonlawyers.com
#
# ⚠️ In subdomain mode the MX record goes on the SUBDOMAIN, never on
# higdonlawyers.com. Pointing an MX record at the firm's own domain redirects
# its live mail -- every client email, every carrier email -- until reverted.
NEXT_PUBLIC_INTAKE_MAIL_DOMAIN="higdonlawyers.com"

# The mailbox everything lands in, for plus-addressing. Leave BLANK to use the
# subdomain shape instead.
NEXT_PUBLIC_INTAKE_MAIL_USER="files"

# Flip to "true" once the MX record is live. Controls only the wording in the
# UI, so staff are not told to CC an address that is not receiving yet.
NEXT_PUBLIC_INTAKE_MAIL_LIVE="false"

# Whose mail counts as "sent by us" on the direction badge. Comma-separated.
NEXT_PUBLIC_FIRM_MAIL_DOMAINS="higdonlawyers.com"

# Shared secret the mail provider sends as `x-inbound-secret`. Generate with:
#   openssl rand -hex 32
# Server-side only -- no NEXT_PUBLIC_ prefix, or it ships to every browser.
# Unset means the webhook returns 503 and files nothing: it fails closed.
INBOUND_EMAIL_SECRET=""

# Service-role key, from Supabase → Project Settings → API. The webhook needs
# it because a mail provider has no user session, so there is no RLS identity.
# ⚠️ This key bypasses RLS entirely. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# ── Google Drive as the document store ───────────────────────────────────
# See docs/GOOGLE_DRIVE_SETUP.md. None of these are needed until Drive
# indexing is turned on; the app runs without them.
#
# ⚠️ No NEXT_PUBLIC_ prefix on any of these. That prefix inlines the value
# into the browser bundle, which on the private key means publishing Drive
# access to every visitor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Keep the newlines as literal \n, exactly as they appear in the JSON key.
GOOGLE_PRIVATE_KEY=""
# A real user to act as. A service account owns no storage, so uploads fail
# with storageQuotaExceeded unless this is set (or the target is a Shared Drive).
GOOGLE_IMPERSONATE_USER=""
# The folder CONTAINING the per-case folders — not My Drive root.
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# ── "Report a problem" ───────────────────────────────────────────────────
# Where the button in the top bar sends reports. Unset and reports are still
# STORED -- the row is written before the email is attempted -- but nobody is
# notified, and the dialog says so rather than showing a tick.
#
# Sending uses the Google service account above, which needs
# https://www.googleapis.com/auth/gmail.send added to the SAME client ID in
# Admin console -> Security -> API controls -> Domain-wide delegation. The
# Drive scope being there already does not cover it.
BUG_REPORT_TO="paul@higdonlawyers.com"
