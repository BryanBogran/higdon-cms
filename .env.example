# ---------------------------------------------------------------------------
# Copy to .env.local for development. NEVER commit a filled-in copy.
# ---------------------------------------------------------------------------

# --- Database (Phase 5+) ---------------------------------------------------
# Local dev: a local Postgres with synthetic data only. Real client data does
# not go in a hosted database until auth exists (Phase 8).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/higdon_cms"

# Production (Neon). Use the POOLED connection string for the app.
# Connect as a dedicated NON-OWNER role -- a table owner can bypass the
# audit table's REVOKE, which defeats append-only. See docs/DECISIONS.md.
# DATABASE_URL="postgresql://app_user:...@ep-xxx-pooler.us-east-2.aws.neon.tech/higdon_cms?sslmode=require"
# Unpooled, for migrations only:
# DATABASE_URL_UNPOOLED="postgresql://owner:...@ep-xxx.us-east-2.aws.neon.tech/higdon_cms?sslmode=require"

# --- Auth (Phase 8) --------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Firm Workspace domain. Enforced SERVER-SIDE in the signIn callback -- the
# OAuth `hd` parameter is client-supplied and spoofable, so it is a UX hint,
# not a control. No self-signup; accounts come from a seeded allowlist.
AUTH_ALLOWED_DOMAIN="higdonlawyers.com"

# Set to "1" ONLY in local development, before Phase 8 lands. Every route
# calls requireSession() from day one; this flag is what lets that happen
# before the provider is configured. Must be unset in any deployed env.
DEV_AUTH_BYPASS=""

# --- Firm settings ---------------------------------------------------------
# All "today" and "overdue" computations resolve in this zone, never the
# browser's. Otherwise a UTC browser flips deadlines a day early after 6pm CT.
FIRM_TIMEZONE="America/Chicago"

# --- AI (Milestone 2, Mail Intake) -----------------------------------------
# Server-side only. The prototype's fetch has no auth headers at all and works
# only inside Claude's artifact sandbox, which injects credentials -- there is
# nothing to "move", the whole auth path gets written fresh.
ANTHROPIC_API_KEY=""
